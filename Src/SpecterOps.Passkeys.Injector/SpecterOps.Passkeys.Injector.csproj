<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <IsPublishable>true</IsPublishable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Exclude XML documentation files from publish output -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <ApplicationIcon>Lock.ico</ApplicationIcon>
    <RootNamespace>SpecterOps.Passkeys.Injector</RootNamespace>
    <!-- Assembly metadata -->
    <AssemblyTitle>Passkey Injector</AssemblyTitle>
    <Product>SpecterOps Passkey Injector</Product>
    <AssemblyName>PasskeyInjector</AssemblyName>
    <Version>2.2.0</Version>
    <Authors>Michael Grafnetter</Authors>
    <Company>SpecterOps</Company>
    <Copyright>Copyright © SpecterOps</Copyright>
    <!-- TypeScript configuration (must be synced with tsconfig.json) -->
    <TypeScriptCompileBlocked>false</TypeScriptCompileBlocked>
    <TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
    <TypeScriptTarget>ES2024</TypeScriptTarget>
    <TypeScriptLib>ES2024,DOM,DOM.Iterable</TypeScriptLib>
    <TypeScriptModuleKind>ESNext</TypeScriptModuleKind>
    <TypeScriptStrict>true</TypeScriptStrict>
    <TypeScriptNoEmitOnError>true</TypeScriptNoEmitOnError>
    <TypeScriptRemoveComments>true</TypeScriptRemoveComments>
    <TypeScriptSourceMap>false</TypeScriptSourceMap>
    <TypeScriptGeneratesDeclarations>false</TypeScriptGeneratesDeclarations>
    <TypeScriptOutDir>.</TypeScriptOutDir>
    <TypeScriptSkipLibCheck>true</TypeScriptSkipLibCheck>
    <TypeScriptNoUnusedLocals>true</TypeScriptNoUnusedLocals>
    <TypeScriptNoUnusedParameters>true</TypeScriptNoUnusedParameters>
    <TypeScriptNoFallthroughCasesInSwitch>true</TypeScriptNoFallthroughCasesInSwitch>
    <TypeScriptNoImplicitReturns>true</TypeScriptNoImplicitReturns>
    <TypeScriptIsolatedModules>true</TypeScriptIsolatedModules>
  </PropertyGroup>

  <!-- Ensure TypeScript compiles before the embedded resource is included -->
  <ItemGroup>
    <TypeScriptCompile Include="WebAuthnBridge.ts" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the compiled JavaScript file -->
    <EmbeddedResource Include="WebAuthnBridge.js">
      <DependentUpon>WebAuthnBridge.ts</DependentUpon>
    </EmbeddedResource>
    <!-- Embed JSON config files -->
    <EmbeddedResource Include="Bookmarks.json" />
    <EmbeddedResource Include="MicrosoftApps.json" />
    <!-- Include icon as resource for WPF window -->
    <Resource Include="Lock.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.3" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.15.0" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="5.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <PackageReference Include="NSec.Cryptography" Version="25.4.0" />
    <PackageReference Include="System.Formats.Cbor" Version="10.0.2" />
  </ItemGroup>

</Project>
