<UserControl x:Class="SpecterOps.Passkeys.Injector.RevealablePasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="32" d:DesignWidth="240"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <PasswordBox x:Name="PasswordBoxControl"
                     Grid.Column="0"
                     MaxLength="{Binding MaxLength, ElementName=Root}"
                     PasswordChanged="OnPasswordBoxChanged"/>

        <TextBox x:Name="TextBoxControl"
                 Grid.Column="0"
                 Visibility="Collapsed"
                 MaxLength="{Binding MaxLength, ElementName=Root}"
                 Text="{Binding Password, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <ToggleButton x:Name="RevealToggle"
                      Grid.Column="1"
                      Margin="4,0,0,0"
                      Padding="6,0"
                      MinWidth="32"
                      VerticalAlignment="Stretch"
                      VerticalContentAlignment="Center"
                      Height="{Binding ActualHeight, ElementName=PasswordBoxControl}"
                      ToolTip="Show / hide password"
                      Checked="OnRevealToggled"
                      Unchecked="OnRevealToggled">
            <TextBlock FontFamily="Segoe Fluent Icons" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="&#xE7B3;"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=RevealToggle}" Value="True">
                                <Setter Property="Text" Value="&#xED1A;"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </ToggleButton>
    </Grid>
</UserControl>
