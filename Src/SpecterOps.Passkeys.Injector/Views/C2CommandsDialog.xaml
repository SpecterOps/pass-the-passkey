<Window x:Class="SpecterOps.Passkeys.Injector.C2CommandsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpecterOps.Passkeys.Injector"
        mc:Ignorable="d"
        Title="C2 Commands"
        Width="760"
        MinWidth="650"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        d:DataContext="{d:DesignInstance Type=local:C2CommandsDialogViewModel, IsDesignTimeCreatable=False}">
    <Window.Resources>
        <local:PublicKeyCredentialHintDescriptionConverter x:Key="PublicKeyCredentialHintDescriptionConverter"/>
    </Window.Resources>

    <DockPanel Margin="12" LastChildFill="True">

        <!-- Close Button (pinned to bottom) -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button IsCancel="True" MinWidth="100">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Close"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Scrollable content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Credential Type Hint -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Authenticator Type Hint:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{x:Static local:C2CommandsDialogViewModel.AuthenticatorTypeHints}"
                              SelectedItem="{Binding SelectedAuthenticatorTypeHint}"
                              MinWidth="200">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource PublicKeyCredentialHintDescriptionConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Additional options -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox Content="Prompt Flood" IsChecked="{Binding PromptFlood}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <CheckBox Content="Kill Credential UI Broker" IsChecked="{Binding KillCredentialUIBroker}" VerticalAlignment="Center"/>
                    <CheckBox Content="Spoof Window Handle" IsChecked="{Binding SpoofWindowHandle}" Margin="20,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- SharpPasskeys Standalone CLI Section -->
                <Expander Header="SharpPasskeys (Standalone CLI)" IsExpanded="False" Margin="0,0,0,8">
                    <StackPanel Margin="8,6,8,6">
                        <ItemsControl ItemsSource="{Binding StandaloneCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:ClipboardEnabledTextBox Text="{Binding Mode=OneWay}" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- SharpPasskeys Mythic Apollo Section -->
                <Expander Header="SharpPasskeys (Mythic Apollo Agent)" IsExpanded="True" Margin="0,0,0,8">
                    <StackPanel Margin="8,6,8,6">
                        <ItemsControl ItemsSource="{Binding MythicCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:ClipboardEnabledTextBox Text="{Binding Mode=OneWay}" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- PowerShell Section -->
                <Expander Header="PowerShell" IsExpanded="False" Margin="0,0,0,0">
                    <StackPanel Margin="8,6,8,6">
                        <ItemsControl ItemsSource="{Binding PowerShellCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:ClipboardEnabledTextBox Text="{Binding Mode=OneWay}" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
