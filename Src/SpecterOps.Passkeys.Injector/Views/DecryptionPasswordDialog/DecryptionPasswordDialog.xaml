<Window x:Class="SpecterOps.Passkeys.Injector.DecryptionPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpecterOps.Passkeys.Injector"
        mc:Ignorable="d"
        Title="{Binding Title}"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        MaxWidth="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=local:DecryptionPasswordDialogViewModel, IsDesignTimeCreatable=True}">
    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="Enter the password used to encrypt this vault export:"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <local:RevealablePasswordBox x:Name="PasswordBox" Margin="0,0,0,8"
                                     Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE783;"
                       Foreground="#C42B1C" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       Foreground="#C42B1C" VerticalAlignment="Center" MaxWidth="380"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="0,0,8,0"/>
            <Button Content="Decrypt" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}"
                    MinWidth="80"
                    Command="{Binding SubmitCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:DecryptionPasswordDialog}}, Path=CloseOnSubmit}"/>
        </StackPanel>
    </StackPanel>
</Window>
