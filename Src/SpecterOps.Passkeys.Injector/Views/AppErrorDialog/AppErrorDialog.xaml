<Window x:Class="SpecterOps.Passkeys.Injector.AppErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpecterOps.Passkeys.Injector"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="340"
        MaxWidth="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=local:AppErrorDialogViewModel, IsDesignTimeCreatable=True}">
    <StackPanel Margin="20,16,20,16">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE783;"
                       FontSize="24" Foreground="#C42B1C"
                       VerticalAlignment="Top" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                       MaxWidth="380" VerticalAlignment="Center"
                       FontSize="13"/>
        </StackPanel>
        <Button Content="OK" IsDefault="True" IsCancel="True"
                Style="{DynamicResource AccentButtonStyle}"
                MinWidth="80" HorizontalAlignment="Right"
                Click="OnOk"/>
    </StackPanel>
</Window>
