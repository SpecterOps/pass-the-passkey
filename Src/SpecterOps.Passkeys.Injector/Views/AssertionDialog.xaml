<Window x:Class="SpecterOps.Passkeys.Injector.AssertionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpecterOps.Passkeys.Injector"
        mc:Ignorable="d"
        Title="Passkey Authentication (WebAuthn Assertion)" Height="768" Width="1024"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Closed="OnDialogClosed"
        d:DataContext="{d:DesignInstance Type=local:AssertionDialogViewModel, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <local:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
        <local:StringArrayToStringConverter x:Key="StringArrayToStringConverter"/>
        <Style x:Key="FormLabelFirstColumnStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,6,6"/>
        </Style>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,6,6,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Request Section -->
        <GroupBox Grid.Row="0" Header="Request">
            <Border Padding="6,0,0,0">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: RpId -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Relying Party ID:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                <local:ClipboardEnabledTextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="7" Text="{Binding RpId, Mode=OneWay}" Focusable="False"/>

                <!-- Row 1: Challenge -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Challenge:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                <local:ClipboardEnabledTextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="7" Text="{Binding Challenge, Mode=OneWay}"/>

                <!-- Row 2: Mediation, User Verification, Hints, Timeout -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Mediation:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Mediation, Mode=OneWay}" IsReadOnly="True"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="User Verification:" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding UserVerification, Mode=OneWay}" IsReadOnly="True"/>
                <TextBlock Grid.Row="2" Grid.Column="4" Text="Hints:" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding Hints, Mode=OneWay, Converter={StaticResource StringArrayToStringConverter}}" IsReadOnly="True"/>
                <TextBlock Grid.Row="2" Grid.Column="6" Text="Timeout:" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Grid.Row="2" Grid.Column="7" Text="{Binding Timeout, Mode=OneWay}" IsReadOnly="True"/>

                <!-- Row 3: Extensions -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Extensions:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="7" Text="{Binding Extensions, Mode=OneWay}" IsReadOnly="True"/>

                <!-- Row 4: AllowCredentials Label -->
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="8" Text="Allow Credentials:" Style="{StaticResource FormLabelFirstColumnStyle}"/>

                <!-- Row 5: AllowCredentials DataGrid -->
                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="8">
                    <DataGrid ItemsSource="{Binding AllowCredentials}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MaxHeight="150"
                              TabIndex="2">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Id" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <local:ClipboardEnabledTextBox Text="{Binding Id, Mode=OneWay}" Focusable="False"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Transports" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Transports, Mode=OneWay, Converter={StaticResource StringArrayToStringConverter}}" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Type" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Type, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- Placeholder shown when grid is empty -->
                    <TextBlock Text="Empty list"
                               HorizontalAlignment="Center"
                               FontStyle="Italic"
                               Visibility="{Binding AllowCredentials.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
                </StackPanel>
                </Grid>
            </Border>
        </GroupBox>

        <!-- Response Section -->
        <GroupBox Grid.Row="1" Header="Response">
            <Border Padding="6,0,0,0">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Public Key Credential (JSON):" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                <TextBox x:Name="ResponseTextBox"
                         Grid.Row="1"
                         Text="{Binding PublicKeyCredentialJson, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         TabIndex="0"/>
                </Grid>
            </Border>
        </GroupBox>
        <!-- Buttons -->
        <Button x:Name="SubmitButton"
        Content="Submit"
        Width="100"
        IsDefault="True"
        Command="{Binding SubmitCommand}"
        HorizontalAlignment="Center"
        Grid.Row="2"
        TabIndex="1" />
    </Grid>
</Window>
