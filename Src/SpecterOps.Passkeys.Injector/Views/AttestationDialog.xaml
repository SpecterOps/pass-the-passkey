<Window x:Class="SpecterOps.Passkeys.Injector.AttestationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpecterOps.Passkeys.Injector"
        mc:Ignorable="d"
        Title="Passkey Registration (WebAuthn Attestation)" Height="820" Width="1100"
        MinWidth="900" MinHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Closed="OnDialogClosed"
        d:DataContext="{d:DesignInstance Type=local:AttestationDialogViewModel, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <local:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
        <local:StringArrayToStringConverter x:Key="StringArrayToStringConverter"/>
        <Style x:Key="FormLabelFirstColumnStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,6,6"/>
        </Style>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,6,6,6"/>
        </Style>
        <Style x:Key="ReadOnlyDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReadOnlyDataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16" LastChildFill="True">

        <!-- Request Section -->
        <Expander Header="Request (Parsed)" IsExpanded="True" DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <!-- Relying Party -->
                            <GroupBox Header="Relying Party" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                                    <local:ClipboardEnabledTextBox Grid.Row="0" Grid.Column="1" Text="{Binding RpName, Mode=OneWay}" Focusable="False"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ID:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                                    <local:ClipboardEnabledTextBox Grid.Row="1" Grid.Column="1" Text="{Binding RpId, Mode=OneWay}" Focusable="False"/>
                                </Grid>
                            </GroupBox>

                            <!-- User -->
                            <GroupBox Header="User">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                                    <local:ClipboardEnabledTextBox Grid.Row="0" Grid.Column="1" Text="{Binding UserName, Mode=OneWay}" Focusable="False"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Display Name:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                                    <local:ClipboardEnabledTextBox Grid.Row="1" Grid.Column="1" Text="{Binding UserDisplayName, Mode=OneWay}" Focusable="False"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ID:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                                    <local:ClipboardEnabledTextBox Grid.Row="2" Grid.Column="1" Text="{Binding UserId, Mode=OneWay}" Focusable="False"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>

                        <GroupBox Grid.Column="1" Header="Authenticator">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Attestation:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Attestation, Mode=OneWay}" IsReadOnly="True"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Formats:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding AttestationFormats, Mode=OneWay, Converter={StaticResource StringArrayToStringConverter}}" IsReadOnly="True"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Resident Key:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ResidentKey, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                            Content="Require Resident Key"
                                            IsChecked="{Binding RequireResidentKey, Mode=OneWay}"
                                            IsEnabled="False"
                                            Margin="12,0,6,0"
                                            VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="User Verification:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UserVerification, Mode=OneWay}" IsReadOnly="True"/>

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Attachment:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding AuthenticatorAttachment, Mode=OneWay}" IsReadOnly="True"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Hints:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Hints, Mode=OneWay, Converter={StaticResource StringArrayToStringConverter}}" IsReadOnly="True"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Algorithms:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CredentialAlgorithms, Mode=OneWay, Converter={StaticResource StringArrayToStringConverter}}" IsReadOnly="True"/>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- Other Options -->
                    <GroupBox Grid.Row="1" Header="Other" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Challenge:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                            <local:ClipboardEnabledTextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Challenge, Mode=OneWay}" Focusable="False"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Extensions:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Extensions, Mode=OneWay}" IsReadOnly="True"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Timeout:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="3"
                                        Text="{Binding Timeout, Mode=OneWay, StringFormat={}{0:N0}}"
                                        IsReadOnly="True"
                                        Width="90"
                                        HorizontalContentAlignment="Right"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Text="Exclude Credentials:" Style="{StaticResource FormLabelFirstColumnStyle}"/>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4">
                                <DataGrid ItemsSource="{Binding ExcludeCredentials}"
                                            AutoGenerateColumns="False"
                                            IsReadOnly="True"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            Background="Transparent"
                                            RowStyle="{StaticResource ReadOnlyDataGridRowStyle}"
                                            CellStyle="{StaticResource ReadOnlyDataGridCellStyle}"
                                            HeadersVisibility="Column"
                                            GridLinesVisibility="Horizontal"
                                            MaxHeight="120"
                                            TabIndex="3">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Id" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <local:ClipboardEnabledTextBox Text="{Binding Id, Mode=OneWay}" Focusable="False"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Transports" Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Transports, Mode=OneWay, Converter={StaticResource StringArrayToStringConverter}}" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Type" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Type, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Empty list"
                                            HorizontalAlignment="Center"
                                            FontStyle="Italic"
                                            Visibility="{Binding ExcludeCredentials.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
        </Expander>

        <!-- Request (JSON) Section -->
        <Expander Header="Request (JSON)" IsExpanded="False" DockPanel.Dock="Top" Margin="0,0,0,8" MaxHeight="220">
            <TextBox Text="{Binding AttestationOptionsJson}"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            AcceptsTab="True"
                            MinLines="3"
                            MinHeight="120"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            TextWrapping="NoWrap"
                            FontFamily="Consolas"/>
        </Expander>

        <!-- Buttons -->
        <Button x:Name="SubmitButton"
                Content="Submit"
                Width="100"
                Style="{DynamicResource AccentButtonStyle}"
                IsDefault="True"
                Command="{Binding SubmitCommand}"
                HorizontalAlignment="Center"
                DockPanel.Dock="Bottom"
                Margin="0,8,0,0"
                TabIndex="1"/>

        <Expander Header="Response (JSON)" IsExpanded="True" DockPanel.Dock="Top" Margin="0,0,0,8" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <TextBox x:Name="ResponseTextBox"
                        Grid.Row="0"
                        Text="{Binding PublicKeyCredentialJson, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        MinLines="3"
                        MinHeight="120"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        TextWrapping="NoWrap"
                        FontFamily="Consolas"
                        TabIndex="0"/>
        </Expander>
    </DockPanel>
</Window>
