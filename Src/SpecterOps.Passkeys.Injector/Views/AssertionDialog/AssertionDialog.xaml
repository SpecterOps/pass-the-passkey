<Window x:Class="SpecterOps.Passkeys.Injector.AssertionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpecterOps.Passkeys.Injector"
        mc:Ignorable="d"
        Title="Passkey Authentication (WebAuthn Assertion)" Height="768" Width="1024"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        d:DataContext="{d:DesignInstance Type=local:AssertionDialogViewModel, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <local:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
        <local:StringArrayToStringConverter x:Key="StringArrayToStringConverter"/>
        <Style x:Key="FormLabelFirstColumnStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,6,6"/>
        </Style>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,6,6,6"/>
        </Style>
        <Style x:Key="ReadOnlyDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReadOnlyDataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16,16,0,16" LastChildFill="True">

        <Button x:Name="SubmitButton"
                MinWidth="100"
                Style="{DynamicResource AccentButtonStyle}"
                IsDefault="True"
                Command="{Binding SubmitCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:AssertionDialog}}, Path=CloseOnSubmit}"
                HorizontalAlignment="Center"
                DockPanel.Dock="Bottom"
                Margin="0,8,16,0"
                TabIndex="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE724;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Submit"/>
            </StackPanel>
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,16,0">

            <!-- Request Section -->
            <Expander Header="Request (Parsed)" IsExpanded="True" ExpandDirection="Down" Margin="0,0,0,8">
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: RpId -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Relying Party ID:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                    <local:ClipboardEnabledTextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="7" Text="{Binding RpId, Mode=OneWay}" Focusable="False"/>

                    <!-- Row 1: Challenge -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Challenge:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                    <local:ClipboardEnabledTextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="7" Text="{Binding Challenge, Mode=OneWay}"/>

                    <!-- Row 2: Mediation, User Verification, Hints, Timeout -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Mediation:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Mediation, Mode=OneWay}" IsReadOnly="True"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="User Verification:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding UserVerification, Mode=OneWay}" IsReadOnly="True"/>
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="Hints:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding Hints, Mode=OneWay, Converter={StaticResource StringArrayToStringConverter}}" IsReadOnly="True"/>
                    <TextBlock Grid.Row="2" Grid.Column="6" Text="Timeout:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="2" Grid.Column="7" Text="{Binding Timeout, Mode=OneWay}" IsReadOnly="True"/>

                    <!-- Row 3: Extensions -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Extensions:" Style="{StaticResource FormLabelFirstColumnStyle}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="7" Text="{Binding Extensions, Mode=OneWay}" IsReadOnly="True"/>

                    <!-- Row 4: AllowCredentials Label -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="8" Text="Allow Credentials:" Style="{StaticResource FormLabelFirstColumnStyle}"/>

                    <!-- Row 5: AllowCredentials DataGrid -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="8">
                        <DataGrid ItemsSource="{Binding AllowCredentials}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  Background="Transparent"
                                  RowStyle="{StaticResource ReadOnlyDataGridRowStyle}"
                                  CellStyle="{StaticResource ReadOnlyDataGridCellStyle}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Top"
                                  TabIndex="2">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Id" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <local:ClipboardEnabledTextBox Text="{Binding Id, Mode=OneWay}" Focusable="False"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Transports" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Transports, Mode=OneWay, Converter={StaticResource StringArrayToStringConverter}}" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Type" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Type, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- Placeholder shown when grid is empty -->
                        <TextBlock Text="Empty list"
                                   HorizontalAlignment="Center"
                                   FontStyle="Italic"
                                   Visibility="{Binding AllowCredentials.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
                    </StackPanel>
                    </Grid>
            </Expander>

            <!-- Request (JSON) Section -->
            <Expander Header="Request (JSON)" IsExpanded="False" ExpandDirection="Down" Margin="0,0,0,8">
                <TextBox Text="{Binding AssertionOptionsJson}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             MinLines="3"
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"/>
            </Expander>

            <!-- Timers Section -->
            <Expander Header="Timers" IsExpanded="True" ExpandDirection="Down" Margin="0,0,0,8">
                <local:TimersControl RequestExpiration="{Binding RequestExpiration}"
                                     ChallengeExpiration="{Binding ChallengeExpiration}"/>
            </Expander>

            <Expander Header="Response (JSON)" IsExpanded="True" ExpandDirection="Down">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Button Command="{Binding PasteResponseCommand}" Margin="0,0,8,0" ToolTip="Paste JSON from clipboard">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE77F;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Paste response"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SignWithKeepassXCCommand}" ToolTip="Sign the challenge with a KeePassXC-exported passkey file">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8D7;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sign with KeePassXC"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowC2CommandsCommand}" Margin="8,0,0,0" ToolTip="Show CLI commands for C2 frameworks">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE756;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Show C2 commands"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBox x:Name="ResponseTextBox"
                                Text="{Binding PublicKeyCredentialJson, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                AcceptsReturn="True"
                                AcceptsTab="True"
                                MinLines="3"
                                MinHeight="120"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto"
                                TextWrapping="NoWrap"
                                FontFamily="Consolas"
                                TabIndex="0"/>
                </DockPanel>
            </Expander>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
