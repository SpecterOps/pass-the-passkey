<Window x:Class="SpecterOps.Passkeys.Injector.TokenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="600" Width="900"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Tokens (JSON):" Margin="0,0,0,8" />
        <TextBox x:Name="TokensTextBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
             FontFamily="Consolas"
             Text="{Binding TokenResponse}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="CopyAccessTokenButton"
                MinWidth="160"
                Margin="0,0,8,0"
                Visibility="{Binding IsAccessTokenPresent, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding CopyAccessTokenCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Copy Access Token" />
                </StackPanel>
            </Button>
            <Button x:Name="CopyRefreshTokenButton"
                MinWidth="160"
                Margin="0,0,8,0"
                Visibility="{Binding IsRefreshTokenPresent, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding CopyRefreshTokenCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Copy Refresh Token" />
                </StackPanel>
            </Button>
            <Button x:Name="CopyIdTokenButton"
                MinWidth="150"
                Margin="0,0,8,0"
                Visibility="{Binding IsIdTokenPresent, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding CopyIdTokenCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Copy ID Token" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
