<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <DetoursRoot Condition="'$(DetoursRoot)'==''">$(MSBuildThisFileDirectory)Detours</DetoursRoot>
    <ItemsProjectGuid>{3B4265A3-EB98-4064-929B-114912DE560D}</ItemsProjectGuid>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;_WIN32_WINNT=0x0501;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(DetoursRoot)\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Detours relies on legacy goto scoping behavior that newer conformance mode rejects. -->
      <AdditionalOptions>/Zc:gotoScope- %(AdditionalOptions)</AdditionalOptions>
      <!-- Vendored Detours trips C26495 in legacy classes we do not want to rewrite locally. -->
      <DisableSpecificWarnings>26495;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(DetoursRoot)\src\detours.cpp" />
    <ClCompile Include="$(DetoursRoot)\src\modules.cpp" />
    <ClCompile Include="$(DetoursRoot)\src\disasm.cpp" />
    <ClCompile Include="$(DetoursRoot)\src\image.cpp" />
    <ClCompile Include="$(DetoursRoot)\src\creatwth.cpp" />
    <ClCompile Include="$(DetoursRoot)\src\disolx86.cpp">
      <ExcludedFromBuild Condition="'$(Platform)'!='Win32'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="$(DetoursRoot)\src\disolx64.cpp">
      <ExcludedFromBuild Condition="'$(Platform)'!='x64'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="$(DetoursRoot)\src\disolarm64.cpp">
      <ExcludedFromBuild Condition="'$(Platform)'!='ARM64'">true</ExcludedFromBuild>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="$(DetoursRoot)\src\detours.h" />
    <ClInclude Include="$(DetoursRoot)\src\detver.h" />
  </ItemGroup>
  <Target Name="ValidateDetoursSource" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(DetoursRoot)\src\detours.h')" Text="Microsoft Detours source was not found. Set the DetoursRoot MSBuild property to the Detours source directory." />
  </Target>
</Project>
