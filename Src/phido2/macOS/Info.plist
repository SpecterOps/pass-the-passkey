	<key>CFBundleIdentifier</key>
	<string>phido2</string>
	<key>CFBundleName</key>
	<string>phido2</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Bluetooth is used to find the phone that scanned the QR code.</string>
</dict>
</plist>
