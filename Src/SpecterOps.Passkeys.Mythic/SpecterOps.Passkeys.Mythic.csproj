<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SharpPasskeys</AssemblyName>

    <!-- Disable the generation of the config file -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AssemblyTitle>Passkeys CLI</AssemblyTitle>
    <Product>SpecterOps Passkeys CLI</Product>
    <Version>1.0.0</Version>
    <!-- CA1848: Use LoggerMessage delegates for performance -->
    <!-- CA1873: Avoid expensive logging argument evaluation -->
    <!-- Acceptable for a short-lived CLI tool with minimal logging -->
    <NoWarn>CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dnMerge" Version="0.5.15">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="DSInternals.Win32.WebAuthn" Version="2.1.0" />
    <PackageReference Include="System.Formats.Cbor" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta5.25277.114" />
  </ItemGroup>

</Project>
