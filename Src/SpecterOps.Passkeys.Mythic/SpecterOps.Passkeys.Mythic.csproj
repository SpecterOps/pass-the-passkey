<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SharpPasskeys</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Disable the generation of the config file -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AssemblyTitle>Passkeys CLI</AssemblyTitle>
    <Product>SpecterOps Passkeys CLI</Product>
    <Version>1.0.0</Version>
    <!-- CA1848: Use LoggerMessage delegates for performance -->
    <!-- CA1873: Avoid expensive logging argument evaluation -->
    <!-- Acceptable for a short-lived CLI tool with minimal logging -->
    <NoWarn>CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dnMerge" Version="0.5.15">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="DSInternals.Win32.WebAuthn" Version="2.1.0" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.275">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Formats.Cbor" Version="10.0.2" />
    <PackageReference Include="System.Text.Json" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta5.25277.114" />
  </ItemGroup>

  <!-- Pull the native WebAuthn hook DLLs (one per architecture) next to the CLI so it can load the matching one at runtime. Silently no-ops if the hook has not been built yet. -->
  <Target Name="CopyWebAuthnHookDlls" AfterTargets="Build">
    <ItemGroup>
      <WebAuthnHookDlls Include="$(ArtifactsPath)\bin\SpecterOps.Passkeys.WebAuthnHook\$(Configuration)\WebAuthnHook_*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(WebAuthnHookDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
