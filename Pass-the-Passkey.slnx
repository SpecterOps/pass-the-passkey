  <!-- Native WebAuthn API hook DLL -->
  <Project Path="Src/SpecterOps.Passkeys.WebAuthnHook/SpecterOps.Passkeys.WebAuthnHook.vcxproj" Id="99f0dd5e-e5b7-48ab-aa57-cb6153ba4cc9" />

  <!-- Additional files -->
